# Base URL of the PHP REST API owned by P1. Same /api root as the resident spec.
# For production behind Apache/XAMPP, set to e.g. http://localhost/api
VITE_API_BASE_URL=http://localhost/api

# 'true'  -> built-in mock data layer (localStorage), used until P1's admin endpoints are ready.
# 'false' -> all calls go to the real PHP API above.
VITE_USE_MOCK=true
